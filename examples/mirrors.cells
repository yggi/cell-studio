&piece title="Mirrors: backwards, upside down, in pieces" tags="tutorial, motifs, counterpoint" rung=11 label="One motif heard forwards, backwards, higher, upside down, and taken apart." about=&out
&sliceNote label="&m[::-1] is the motif backwards (its retrograde); &m[0:4] its first four steps; &m[-1] its last; &m^7 all of it seven semitones up." about=&tune
&inverseNote label="inverse(&m) mirrors it within the scale, round its first degree: up becomes down." about=&answer
&bar scan(1 1 1 1) step=free(andante)
&dorian over=scale(2,3) label="**{mode}** on {tonic}"

&m 0 1 2 4 3 1 2@2
&tune over=&dorian step=&bar/2 &m &m[::-1] &m^7 &m[0:4]!2 &m[-1]@4
&answer over=&dorian step=&bar/2 ~@16 inverse(&m) degree(inverse(&m), 4) ~@4

&flute s=tri loop=D4 env=&(map=adsr .02 .3 .5 .3)
&cello s=saw loop=D3 lpf=1200 env=&(map=adsr .03 .3 .6 .3)
&out map=sample level=13.5 [&tune * &flute * .35, &answer * &cello * .25]
