{
  "name": "cell-studio",
  "private": true,
  "version": "0.9.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tools/test.mjs",
    "test:all": "vitest run",
    "test:slow": "vitest run --project slow --passWithNoTests",
    "test:watch": "vitest",
    "check": "node tools/check-stale.mjs && svelte-check --tsconfig ./tsconfig.json --tsgo && node tools/strict.mjs",
    "smoke": "node tools/smoke.mjs",
    "docs:examples": "UPDATE_EXAMPLES_DOC=1 vitest run src/examplesDoc.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "knip": "knip",
    "preverify": "node tools/install-first.mjs && node tools/verified.mjs begin",
    "verify": "npm run check && npm run lint && npm run format:check && npm run knip && npm test",
    "postverify": "node tools/verified.mjs end",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@xyflow/svelte": "^1.7.0",
    "@yggi/cells": "github:yggi/cells#v0.3.0",
    "@yggi/webmidi": "github:yggi/webmidi#v0.1.0",
    "d3-force": "^3.0.0",
    "tone": "^15.1.22"
  }
}
